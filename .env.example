# Local retrieval requires no key. Copy this file to .env only when enabling DeepInfra.
DEEPINFRA_API_KEY=
# Copy exact current model IDs from DeepInfra's model catalog. No guessed defaults.
DEEPINFRA_MODEL=
# Benchmark model names and rates belong in config/remote_models.json.
LANGSMITH_TRACING=false
HF_HUB_DISABLE_TELEMETRY=1
